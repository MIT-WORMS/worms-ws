{
    "name": "WORMS Dev Container",
    "privileged": true,
    "remoteUser": "worms",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "worms"
        }
    },
    "workspaceFolder": "/home/worms-ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/worms-ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions": [
                // Python and linting
                "ms-python.python",
                "charliermarsh.ruff",
                // C++ and cmake helpers
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cmake-tools",
                // ROS2 specific
                "ranch-hand-robotics.rde-pack",
                // Helps with formatting YAML
                "redhat.vscode-yaml",
                // Works well with git
                "eamodio.gitlens"
            ]
        },
        "settings": {
            "clangd.arguments": [
                "--background-index",
                "--compile-commands-dir=/home/worms-ws/build"
            ],
            // Cpp settings conflict with clangd
            "C_Cpp.intelliSenseEngine": "disabled",
            "C_Cpp.formatting": "disabled",
            // Formatters for each language
            "[cpp]": {
                "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
                "editor.formatOnSave": true
            },
            "[c]": {
                "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
                "editor.formatOnSave": true
            },
            "[python]": {
                "editor.defaultFormatter": "charliermarsh.ruff",
                "editor.formatOnSave": true
            },
            "[yaml]": {
                "editor.defaultFormatter": "redhat.vscode-yaml",
                "editor.formatOnSave": true
            },
            // Python linting settings
            "ruff.enable": true,
            "ruff.lint.enable": true,
            "ruff.lineLength": null,
            "editor.formatOnSave": true,
            // Some type checking
            "python.analysis.typeCheckingMode": "standard",
            // Standardize editor settings
            "editor.insertSpaces": true,
            "files.encoding": "utf8"
        }
    },
    "containerEnv": {
        "DISPLAY": "${env:DISPLAY}",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "42"
    },
    "runArgs": [
        "--net=host"
    ],
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached"
    ],
    // Update deps, import repos, install dependencies
    "postCreateCommand": "sudo apt-get update && mkdir -p src && vcs import src < worms.repos || true && rosdep update && rosdep install --from-paths src --ignore-src -y"
}